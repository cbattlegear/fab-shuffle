{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Fab Shuffle, running as a single-replica Azure Container App. Fab Shuffle keeps its session and run state in memory, so the app is deliberately pinned to one replica: a second one would not see your sign-in or your migration."
  },
  "parameters": {
    "appName": {
      "type": "string",
      "defaultValue": "",
      "maxLength": 32,
      "metadata": {
        "description": "Optional. Leave blank to generate a stable fab-shuffle name for this resource group. To update an existing deployment, use its current app name (or leave blank if it used the generated default)."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional Azure region code, such as canadacentral. Leave blank to use the selected resource group's region. This is where Fab Shuffle runs, not the migration's destination capacity region."
      }
    },
    "containerImage": {
      "type": "string",
      "defaultValue": "ghcr.io/cbattlegear/fab-shuffle:latest",
      "metadata": {
        "description": "Image to run. The default is the public build from this repository and needs no registry credentials."
      }
    },
    "cpuCores": {
      "type": "string",
      "defaultValue": "2",
      "allowedValues": ["1", "2", "4"],
      "metadata": {
        "description": "vCPU. Schema transfer shells out to sqlpackage, a .NET process of a few hundred megabytes, and two of those run at once by default, so 2 is the sensible floor."
      }
    },
    "memoryGb": {
      "type": "string",
      "defaultValue": "4",
      "allowedValues": ["2", "4", "8"],
      "metadata": {
        "description": "Memory in GiB. Must be exactly double the vCPU count for the consumption workload profile."
      }
    },
    "allowedClientIpAddress": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Your public IP address or CIDR range, for example 203.0.113.4/32. Strongly recommended: Fab Shuffle has no sign-in of its own, so leaving this empty publishes the wizard to the whole internet."
      }
    },
    "shareQuotaGiB": {
      "type": "int",
      "defaultValue": 100,
      "minValue": 1,
      "maxValue": 102400,
      "metadata": {
        "description": "Total Azure Files share quota in GiB, including concurrent staging and retained journals. Default 100 GiB is not a measured requirement. Use scripts/Get-FabShuffleStorageEstimate.ps1 to estimate your workload; this quota is separate from the per-operation disk and memory budgets."
      }
    },
    "maxDiskStagingGiB": {
      "type": "int",
      "defaultValue": 10,
      "minValue": 1,
      "maxValue": 102400,
      "metadata": {
        "description": "Disk budget per bounded schema/checkpoint operation, in GiB. Does not reserve space or resize the Azure Files share. Legacy single-principal AzCopy/bcp exports are not capped by this setting; size the share for their full staging requirements."
      }
    },
    "maxMemoryMiB": {
      "type": "int",
      "defaultValue": 1024,
      "minValue": 1,
      "maxValue": 8192,
      "metadata": {
        "description": "In-memory transfer/metadata budget per operation, in MiB. This is not the container RAM limit or a hard process cap. Leave room for concurrent workers, Python and external tools; increasing disk staging does not require increasing this budget."
      }
    }
  },
  "variables": {
    "appName": "[if(empty(parameters('appName')), concat('fab-shuffle-', uniqueString(resourceGroup().id)), parameters('appName'))]",
    "location": "[if(empty(parameters('location')), resourceGroup().location, parameters('location'))]",
    "environmentName": "[concat(variables('appName'), '-env')]",
    "logAnalyticsName": "[concat(variables('appName'), '-logs')]",
    "restrictIngress": "[not(empty(parameters('allowedClientIpAddress')))]",
    "ipRestrictions": [
      {
        "name": "allow-operator",
        "action": "Allow",
        "ipAddressRange": "[parameters('allowedClientIpAddress')]",
        "description": "The only address allowed to reach the wizard."
      }
    ],
    "storageAccountName": "[toLower(concat('fabshuffle', uniqueString(resourceGroup().id, variables('appName'))))]",
    "fileShareName": "fab-shuffle-share",
    "storageMountName": "fab-shuffle-storage",
    "scratchVolumeName": "fab-shuffle-scratch",
    "scratchMountPath": "/app/local"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('logAnalyticsName')]",
      "location": "[variables('location')]",
      "properties": {
        "sku": { "name": "PerGB2018" },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[variables('environmentName')]",
      "location": "[variables('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]"
      ],
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName')), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName')), '2023-09-01').primarySharedKey]"
          }
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[variables('storageAccountName')]",
      "location": "[variables('location')]",
      "kind": "StorageV2",
      "sku": { "name": "Standard_LRS" },
      "properties": {
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true,
        "allowBlobPublicAccess": false,
        "allowSharedKeyAccess": true,
        "largeFileSharesState": "Enabled"
      },
      "metadata": {
        "description": "Persistent SMB storage authenticated with an account key. Large file shares are explicitly enabled because the shares API still documents that gate for quotas above 5120 GiB, even though newer guidance calls it a legacy setting. The authenticated public storage endpoint is not restricted by the wizard's ingress rule; see README for private-network requirements and key rotation."
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/fileServices/shares",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}/default/{1}', variables('storageAccountName'), variables('fileShareName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ],
      "properties": {
        "shareQuota": "[parameters('shareQuotaGiB')]",
        "enabledProtocols": "SMB",
        "accessTier": "TransactionOptimized"
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments/storages",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}/{1}', variables('environmentName'), variables('storageMountName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', variables('environmentName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts/fileServices/shares', variables('storageAccountName'), 'default', variables('fileShareName'))]"
      ],
      "properties": {
        "azureFile": {
          "accountName": "[variables('storageAccountName')]",
          "accountKey": "[listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2023-01-01').keys[0].value]",
          "shareName": "[variables('fileShareName')]",
          "accessMode": "ReadWrite"
        }
      }
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[variables('appName')]",
      "location": "[variables('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', variables('environmentName'))]",
        "[resourceId('Microsoft.App/managedEnvironments/storages', variables('environmentName'), variables('storageMountName'))]"
      ],
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('environmentName'))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "targetPort": 8080,
            "transport": "auto",
            "allowInsecure": false,
            "stickySessions": { "affinity": "sticky" },
            "ipSecurityRestrictions": "[if(variables('restrictIngress'), variables('ipRestrictions'), createArray())]"
          }
        },
        "template": {
          "containers": [
            {
              "name": "fab-shuffle",
              "image": "[parameters('containerImage')]",
              "resources": {
                "cpu": "[json(parameters('cpuCores'))]",
                "memory": "[concat(parameters('memoryGb'), 'Gi')]"
              },
              "env": [
                {
                  "name": "FAB_SHUFFLE_SCRATCH",
                  "value": "[variables('scratchMountPath')]"
                },
                {
                  "name": "FAB_SHUFFLE_MAX_DISK_STAGING_BYTES",
                  "value": "[string(mul(parameters('maxDiskStagingGiB'), 1073741824))]"
                },
                {
                  "name": "FAB_SHUFFLE_MAX_MEMORY_BYTES",
                  "value": "[string(mul(parameters('maxMemoryMiB'), 1048576))]"
                }
              ],
              "volumeMounts": [
                {
                  "volumeName": "[variables('scratchVolumeName')]",
                  "mountPath": "[variables('scratchMountPath')]"
                }
              ],
              "probes": [
                {
                  "type": "Readiness",
                  "httpGet": { "path": "/api/health", "port": 8080 },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 10
                },
                {
                  "type": "Liveness",
                  "httpGet": { "path": "/api/health", "port": 8080 },
                  "initialDelaySeconds": 30,
                  "periodSeconds": 30,
                  "failureThreshold": 5
                }
              ]
            }
          ],
          "volumes": [
            {
              "name": "[variables('scratchVolumeName')]",
              "storageType": "AzureFile",
              "storageName": "[variables('storageMountName')]"
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 1
          }
        }
      }
    }
  ],
  "outputs": {
    "url": {
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.App/containerApps', variables('appName')), '2024-03-01').configuration.ingress.fqdn)]",
      "metadata": { "description": "Open this to start the wizard." }
    },
    "ingressIsPublic": {
      "type": "bool",
      "value": "[not(variables('restrictIngress'))]",
      "metadata": { "description": "True when no IP restriction was given, so anyone with the URL can reach the wizard." }
    }
  }
}
